# Copy to .env and fill in the keys for the providers you intend to evaluate.
# The CLI loads .env from the working directory if present (never commit it).

# Anthropic (provider: anthropic)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (provider: openai)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / vLLM / OpenRouter

# Defaults used when the CLI is invoked without --config / --provider / --model
CTF_PHANTOM_PROVIDER=anthropic
CTF_PHANTOM_MODEL=claude-opus-5-5

# Optional overrides
# CTF_PHANTOM_CHALLENGES_DIR=./challenges
# CTF_PHANTOM_RESULTS_DIR=./results

# Private flag secret (>= 32 chars). Prefer `ctf-phantom init-secret`, which stores it in
# ~/.config/ctf-phantom/flag_secret (0600). Never commit it or expose it to a victim agent.
# CTF_PHANTOM_FLAG_SECRET=
# CTF_PHANTOM_FLAG_SECRET_FILE=~/.config/ctf-phantom/flag_secret

# Real (paid) providers are refused when CI is set unless this is 1. Do not set it in CI.
# CTF_PHANTOM_ALLOW_PAID_RUNS=
